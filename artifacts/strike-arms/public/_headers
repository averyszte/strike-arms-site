# Cloudflare Pages response headers.
#
# The Supabase origin below is the project ref, not a secret -- it is in every
# request the browser makes. It is written out in full rather than as a
# wildcard so a different project cannot be talked to from this site by
# accident. It must be changed alongside VITE_SUPABASE_URL.
#
# Verify after the first deploy: open the site, check the console for CSP
# violations on the home page, a product page, the cart, and a checkout
# redirect. A CSP that blocks the app fails silently for users and loudly only
# in the console.

/*
  # HSTS. Two years and preload-eligible; do not shorten without meaning to,
  # browsers remember the longest value they have seen.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here asks for any of these. Payment is included because checkout
  # happens on Stripe's own domain, never on ours.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # style-src needs 'unsafe-inline': Radix and framer-motion both set style
  # attributes on elements, and there is no nonce to give them. script-src
  # deliberately does not -- the app ships no inline script and must not start.
  # challenges.cloudflare.com is Turnstile, the bot check on checkout and order
  # lookup: its script, the iframe it draws in, and its calls home.
  # www.google.com in frame-src is the shop map on the homepage.
  # connect-src (M-014, checked 2026-11-14): the browser talks only to this
  # Supabase project (REST, Auth, Storage, Realtime and the edge functions) and
  # to Turnstile. Stripe Checkout is a full-page redirect, so it needs no
  # connect-src entry. This is independent of the ALLOWED_ORIGINS function
  # secret: that one lists the sites allowed to call the functions, this one
  # lists the hosts this site may call. Nothing here changes when that secret
  # is set. If the Supabase project ever changes, update the ref in img-src and
  # connect-src in the same deploy as VITE_SUPABASE_URL.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://cxnhkgndvzgyqhiwsvrr.supabase.co; media-src 'self'; connect-src 'self' https://cxnhkgndvzgyqhiwsvrr.supabase.co wss://cxnhkgndvzgyqhiwsvrr.supabase.co https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Hashed filenames, so the content at a given URL never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell must not be cached, or a deploy leaves people on the old bundle.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Deep links (/products/x, /store/rifles) are served the same index.html by the
# Pages SPA fallback. There is deliberately no `/*` Cache-Control rule for
# them: Pages joins the values of a header set by two matching rules with a
# comma, so a `/*` no-cache would be glued onto the /assets/* immutable value
# above and onto the image rules below. Pages already sends HTML with
# `public, max-age=0, must-revalidate`, which is what we want (M-059, A5-23).
# The runbook has a `curl -I` on a deep link to confirm it after each deploy.

# Static images and video in public/. Their names are not content-hashed, so
# they are not immutable: a week, then served stale for a day while the edge
# revalidates (M-059, A4-09). Replacing one of these files in place can show
# the old copy for up to a week; give a changed image a new filename instead.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# Transactional and account pages. robots.txt asks crawlers not to fetch these;
# a header is what stops one that fetched anyway from indexing the result.
/cart
  X-Robots-Tag: noindex, nofollow

/checkout/*
  X-Robots-Tag: noindex, nofollow

/account
  X-Robots-Tag: noindex, nofollow

/account/*
  X-Robots-Tag: noindex, nofollow

/admin
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow
